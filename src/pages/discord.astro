---
import BaseLayout from "../layouts/BaseLayout.astro";
import DiscordContent from "../../content/discord.md";
import MarkdownPanel from "../components/MarkdownPanel.astro";
import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Discord · BSides Detroit" description="Join the BSides Detroit community on Discord.">
  <div class="page-wrap">
    <PageHero eyebrow="connect / discord" title="Join Discord" summary="Stay connected with the BSides Detroit community between events." />
    <MarkdownPanel label="[ uplink // community channel ]">
      <div class="discord-callout"><DiscordContent /></div>
    </MarkdownPanel>
  </div>
</BaseLayout>
