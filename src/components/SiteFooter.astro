---
import * as SitePage from "../../content/site.md";
const { contact, legal } = SitePage.frontmatter.footer;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-grid">
    <section>
      <p class="terminal-label">$ whoami</p>
      <p>BSides Detroit, an independent, volunteer-run InfoSec conference in Detroit, Michigan.</p>
    </section>

    <section>
      <p class="terminal-label">$ cat contact.txt</p>
      <ul>
        {contact.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </section>

    <section>
      <p class="terminal-label">$ ls /legal</p>
      <ul>
        {legal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </section>
  </div>

  <p class="copyright">© {year} BSides Detroit · built with Astro · hosted on GitHub Pages</p>
</footer>
