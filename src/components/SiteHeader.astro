---
import * as SitePage from "../../content/site.md";
const navItems = SitePage.frontmatter.nav;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <div class="terminal-boot" aria-label="site status">
    <span>$ establishing detroit uplink...</span>
    <span>$ signal acquired. welcome, operator.</span>
  </div>

  <div class="nav-shell">
    <a class="brand" href={base} aria-label="BSides Detroit home">
      <span class="prompt">[root@detroit]#</span>
      <span>BSides Detroit</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a href={`${base}${item.href.slice(1)}`}>{item.label}</a>
        ))
      }
    </nav>

    <details class="mobile-nav">
      <summary>menu</summary>
      <nav aria-label="Mobile navigation">
        {
          navItems.map((item) => (
            <a href={`${base}${item.href.slice(1)}`}>{item.label}</a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
