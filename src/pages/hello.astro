---
import HelloContent from "../../content/hello.md";
import MarkdownPanel from "../components/MarkdownPanel.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Hello · BSides Detroit" description="Join the BSides Detroit community and contact the organizers.">
  <div class="page-wrap">
    <PageHero
      eyebrow="./hello"
      title="Hello"
      summary="Find the Discord, organizer contact details, and ways to stay connected between events."
    />
    <MarkdownPanel label="[ comms // open channel ]">
      <HelloContent />
    </MarkdownPanel>
  </div>
</BaseLayout>
