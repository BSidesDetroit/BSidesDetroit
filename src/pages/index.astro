---
import * as HomePage from "../../content/home.md";
import MarkdownPanel from "../components/MarkdownPanel.astro";
import StatStrip from "../components/StatStrip.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const { Content: HomeContent, frontmatter } = HomePage;
---

<BaseLayout
  title="BSides Detroit"
  description="BSides Detroit is back. Hack more. Help people. Secure all."
>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="signal-line">&gt; {frontmatter.signal}</p>
      <p class="kicker">{frontmatter.kicker}</p>
      <h1 class="sr-only">BSides Detroit</h1>
      <p>{frontmatter.tagline}</p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="button primary" href="/discord">./discord</a>
        <a class="button" href="/sponsor">./sponsor</a>
        <a class="button" href="/past">cat /past</a>
      </div>
    </div>

    <div class="logo-frame">
      <img src="/assets/bsides-detroit.webp" alt="BSides Detroit logo" />
    </div>
  </section>

  <div class="page-wrap">
    <StatStrip />

    <MarkdownPanel label="[ sector 01 // broadcast ]">
      <HomeContent />
    </MarkdownPanel>

    <section class="mission-brief">
      <p class="panel-label">$ ./mission-brief --city detroit</p>
      <pre><code>{frontmatter.mission}</code></pre>
    </section>
  </div>
</BaseLayout>
